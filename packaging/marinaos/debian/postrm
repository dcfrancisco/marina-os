#!/bin/sh
set -eu
if [ "$1" = remove ] || [ "$1" = purge ]; then
    if command -v deb-systemd-helper >/dev/null; then
        deb-systemd-helper disable marinaosd.service >/dev/null || true
        if [ "$1" = purge ]; then deb-systemd-helper purge marinaosd.service >/dev/null || true; fi
    fi
fi
if [ -d /run/systemd/system ]; then systemctl daemon-reload; fi
