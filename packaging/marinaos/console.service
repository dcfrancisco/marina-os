[Unit]
Description=MarinaOS interactive console
Documentation=https://github.com/dannyfrancisco/intent-driven-os/tree/main/docs/adr/0023-oid-linux-distribution-boot-lifecycle-and-system-services
After=oid-readiness.service
Wants=oid-readiness.service

[Service]
Type=simple
User=oid
Group=oid
EnvironmentFile=-/etc/oid/marina-client.env
EnvironmentFile=-/etc/marinaos/marina-client.env
Environment=OID_RUNTIME_BACKEND=talvik-ipc
Environment=OID_MARINA_URL=http://127.0.0.1:12434
Environment=TALVIK_SOCKET=/run/marina/marina.sock
Environment=OID_STATE_DIR=/var/lib/marinaos/console
Environment=OID_HISTORY_FILE=/var/lib/marinaos/console/history
Environment=OID_MARINA_MODEL=
Environment=LD_LIBRARY_PATH=/usr/lib/marinaos
WorkingDirectory=/var/lib/marinaos/console
ExecStart=/usr/bin/console
Restart=on-failure
RestartSec=2s
StandardInput=tty
StandardOutput=journal+console
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/marinaos/console /run/marinaos-console
SupplementaryGroups=marina

[Install]
WantedBy=multi-user.target
